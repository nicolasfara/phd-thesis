%-----------------------------------------------------
% LISTING CONFIGURATIONS
%-----------------------------------------------------

\crefname{lstlisting}{listing}{listing}
\Crefname{lstlisting}{Listing}{Listing}
% Line-level labels inside listings (see the escapechar mechanism below).
\crefname{lstnumber}{line}{lines}
\Crefname{lstnumber}{Line}{Lines}
\renewcommand\lstlistlistingname{List of Listings}

% Allow \label inside a listing (via escapechar) to attach to the current line
% number rather than to the enclosing counter. Without this, the line labels
% Chapter 6 uses to point at individual lines of a snippet resolve to the wrong
% number. Workaround from https://tex.stackexchange.com/q/737204/2388.
\makeatletter
\lst@AddToHook{Init}{\def\@currentcounter{lstnumber}}%
\AtBeginDocument{%
  \def\ltx@label#1{\cref@label{#1}}%            add braces
  \def\label@in@display@noarg#1{\cref@old@label@in@display{#1}}% remove braces
  \def\label@in@mmeasure@noarg#1{%
    \begingroup%
    \measuring@false%
    \cref@old@label@in@display{#1}%
    \endgroup
  }%
}
\makeatother

