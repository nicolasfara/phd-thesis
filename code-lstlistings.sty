% VS Code Light+ palette, as used by the two source papers, so that the
% listings in Chapter 6 render as they do in the publications they come from.

\definecolor{vscLightBackground}{HTML}{F5F5F5}
\definecolor{vscLightKeyword}{HTML}{AF00DB}
\definecolor{vscLightType}{HTML}{267F99}
\definecolor{vscLightString}{HTML}{A31515}
\definecolor{vscLightComment}{HTML}{008000}
\definecolor{vscLightFunction}{HTML}{795E26}
\definecolor{vscLightNumber}{HTML}{098658}
\definecolor{vscLightLineNum}{HTML}{C8C8C8}
\definecolor{vscLightText}{HTML}{000000}
\definecolor{vscLightCapability}{HTML}{16697A}

% One Scala 3 definition serving both source papers. Their own styles disagreed
% on which class holds peer names, library types, and capabilities; the six
% classes below fix a single assignment for the whole chapter.
%   [1] language keywords          [4] paradigm operations
%   [2] operators                  [5] capabilities and scopes
%   [3] library/architecture types [6] peer names
\lstdefinelanguage{Scala3}{
	morekeywords={
		abstract,case,catch,class,def,derives,do,else,end,enum,export,extends,
		false,final,finally,for,forSome,given,if,implicit,import,infix,inline,
		lazy,match,new,null,object,opaque,open,override,package,private,
		protected,return,sealed,super,then,this,throw,trait,transparent,true,
		try,type,update,using,val,var,while,with,yield
	},
	otherkeywords={?,=>,?=>,<-,<:,>:,\#,=>>,@peer,@multitier},
	morekeywords=[2]{=>,?=>,?->,<-,<:,>:,\#,=>>},
	morekeywords=[3]{
		Option,Some,None,Either,Left,Right,Try,Success,Failure,Future,CanEqual,
		Iterable,Ordering,Tuple,Map,List,Set,Vector,Seq,Unit,Int,String,Boolean,
		Double,NonEmptyList,Task,Signal,Monad,Tie,Single,Multiple,TiedSingle,
		TiedMultiple,TiedWithSingle,TiedWithMultiple,TiedToMultiple,Label,
		Anisotropic,Quantifier,Environment,Remote,Erased,SharedCapability,
		PeerTag,Flow,PlacedFlow,Reference,Address
	},
	morekeywords=[4]{
		placed,asLocal,asLocalAll,on,at,take,takeAll,run,handle,flowOn,comm,
		locally,multicast,broadcast,rep,nbr,branch,mux,choreography,collective,
		multitier,isotropicComm,anisotropicComm,anisotropicMessage,
		coAnisotropicComm,reachablePeers,alivePeersOf,localAddress,projectedOn,
		% ScaFi operators, for chapter 7. The building blocks G, C, and S are
		% deliberately left out: a single-capital keyword would also repaint the
		% type parameters S and R of the ScalaTropy signatures in chapter 6.
		sense,share,foldhood,foldhoodPlus,minHood,minHoodPlus,maxHood,
		maxHoodPlus,nbrRange,mid
	},
	morekeywords=[5]{
		Placement,Multitier,Choreography,Collective,Multiparty,MultiParty,
		Network,Mutable,Scope,PeerScope,MultitierScope,ChoreographyScope,
		CollectiveScope,VM
	},
	morekeywords=[6]{
		Client,Server,DB,Database,Phone,Edge,Cloud,Organizer,Peer,Coordinator,
		Participant,Dashboard,Master,Worker,Primary,Backup,Alice,Bob
	},
	sensitive=true,
	morecomment=[l]{//},
	morecomment=[s]{/*}{*/},
	morestring=[b]",
	morestring=[b]',
}

