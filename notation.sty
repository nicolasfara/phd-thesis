% Notation for the pulverization model (Chapter 5, reused in Chapter 6).
% Adopted from the ACSOS 2024 paper "Flexible Self-organisation for the
% Cloud-Edge Continuum: a Macro-programming Approach", so that the thesis and
% the published formalisation use the same symbols.
% Requires amsmath (loaded in the main preamble, before cleveref).

%----------------------------------------------------------------------------------------
% DEVICES AND TOPOLOGY
%----------------------------------------------------------------------------------------
\newcommand{\deviceId}{\delta}                 % a device
\newcommand{\hostIdSet}{\mathbf{D}_P}          % physical devices
\newcommand{\deviceIdSet}{\mathbf{D}}          % application devices
\newcommand{\ihostIdSet}{\mathbf{D}_{I}}       % infrastructural devices
\newcommand{\pnbrhood}{\mathcal{N}_P}          % physical neighbourhood relation
\newcommand{\nbrhood}{\mathcal{N}}             % application neighbourhood relation
\newcommand{\neigh}{\mathit{neigh}}            % neigh(d) = neighbours of d, d included
\newcommand{\Sens}{\mathit{sense}}             % sense(d) = sensor state at d
\newcommand{\senstate}{\sigma}                 % sensor state

%----------------------------------------------------------------------------------------
% MACRO-PROGRAM STRUCTURE
%----------------------------------------------------------------------------------------
\newcommand{\macroProgram}{\mathtt{MP}}        % the macro-program
\newcommand{\component}{\mathtt{C}}            % a component
\newcommand{\port}{\mathtt{p}}                 % a port
\newcommand{\compLinks}{\mathtt{B}}            % a binding
\newcommand{\compdef}{\mathit{component}}      % the component connection relation
\newcommand{\compDef}[3]{\compdef(#1,#2,#3)}   % component(outPort, component, inPorts)

%----------------------------------------------------------------------------------------
% COMPONENT STATE, ROUNDS, AND DEPLOYMENT
%----------------------------------------------------------------------------------------
\newcommand{\vtree}{\theta}                    % state produced by a round
\newcommand{\anyvalue}{\mathtt{v}}             % a value
\newcommand{\val}{\mathit{val}}                % val(state) = observable value
\newcommand{\deploy}{\mathit{deploy}}          % deployment predicate (forwarding chain)
\newcommand{\envmap}[2]{#1\mapsto #2}          % map entry
% Single-round judgment: device; neighbour states; sensor state |- C(inputs) => state
\newcommand{\bsopsem}[5]{#1;#2;#3\vdash #4\Downarrow #5}

%----------------------------------------------------------------------------------------
% MULTIPARTY LANGUAGES (Chapter 6)
%----------------------------------------------------------------------------------------
% Shared by the two source papers, whose own formalism.sty files overlap.
% Only the symbols the chapter actually prints are kept: the inference-rule
% machinery of the papers is deliberately not carried over.
\newcommand{\arch}{\mathcal{A}}                     % architecture specification
\newcommand{\pfam}[1][]{\mathsf{P}_{#1}}            % a peer type
\newcommand{\peerinst}[2][]{\pi_{#1}^{#2}}          % an instance of peer type #2
\newcommand{\peerconf}{\Omega}                      % runtime peer configuration
\newcommand{\vmstate}{\sigma}                       % aggregate VM state
\newcommand{\tieSingle}[2]{#1\mapsto^{1}#2}         % single tie
\newcommand{\tieMult}[2]{#1\mapsto^{*}#2}           % multiple tie
\newcommand{\capset}[1][]{\mathsf{C}_{#1}}          % a capability set
\newcommand{\mptype}[1][]{\mathsf{T}_{#1}}          % a type
\newcommand{\mpexpr}[1][]{\mathsf{e}_{#1}}          % an expression
\newcommand{\ton}[2]{#1\;\mathsf{on}\;#2}           % placement type: T on P
% Capability-annotated typing judgment: A; G |- e : T with C
\newcommand{\typing}[4]{\arch;#1\vdash #2 : #3\;\mathsf{with}\;#4}
% Reduction: Omega; sigma |> e ->^pi Omega'; sigma' |> e'
\newcommand{\redn}[5]{#1\triangleright #2\;\rightarrow^{#5}\;#3\triangleright #4}
