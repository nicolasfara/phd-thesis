% Chapter 6 sets the framework and scenario names in sans serif, matching how
% the source papers set them. Other system names (ScalaTropy, PulvReAKt, ScaFi,
% Alchemist) stay plain, as elsewhere in the thesis.
\newcommand{\camil}{\textsf{CaMiL}\xspace}
\newcommand{\cityevt}{\textsf{CityEvt}\xspace}
\newcommand{\smrtmob}{\textsf{SmrtMob}\xspace}

% Research questions. The three thesis-level questions are numbered by a
% counter and referenced with \cref{rq:...}, so no number is typed in prose.
% Generation is an unnumbered subcase of the second question. \rqhead opens
% a question paragraph; \subrqhead remains available for numbered sub-questions.
\newcounter{researchquestion}
\newcounter{subresearchquestion}[researchquestion]
\renewcommand{\theresearchquestion}{RQ\arabic{researchquestion}}
\renewcommand{\thesubresearchquestion}{\theresearchquestion.\arabic{subresearchquestion}}
\newcommand{\rqhead}[2]{%
  \refstepcounter{researchquestion}%
  \paragraph{\theresearchquestion{} -- #2.}\label{#1}}
\newcommand{\subrqhead}[2]{%
  \refstepcounter{subresearchquestion}%
  \paragraph{\thesubresearchquestion{} -- #2.}\label{#1}}
% cleveref is loaded after this package, so its formats have to be deferred.
% The counter already prints "RQ1", hence no name is prepended.
\AtBeginDocument{%
  \crefformat{researchquestion}{#2#1#3}%
  \Crefformat{researchquestion}{#2#1#3}%
  \crefformat{subresearchquestion}{#2#1#3}%
  \Crefformat{subresearchquestion}{#2#1#3}%
  \crefmultiformat{researchquestion}{#2#1#3}{ and~#2#1#3}{, #2#1#3}{, and~#2#1#3}%
  \Crefmultiformat{researchquestion}{#2#1#3}{ and~#2#1#3}{, #2#1#3}{, and~#2#1#3}%
  \crefrangeformat{researchquestion}{#3#1#4--#5#2#6}%
  \Crefrangeformat{researchquestion}{#3#1#4--#5#2#6}%
}
